# Copy this file to .env. Never commit real API keys.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions

# Optional GPT-5.6 Luna routing (the endpoint must explicitly support the
# configured reasoning_effort field; live capability remains to be verified).
LUNA_API_KEY=
LUNA_ENDPOINT=
LUNA_MODEL=gpt-5.6-luna
# Runtime sends high for LUNA_HIGH and xhigh for LUNA_EXTRA_HIGH.

# Optional temporary ChatGPT-authenticated Codex CLI reasoning backend.
# No API key is used or required. Codex owns its local ChatGPT auth session.
CODEX_EXEC_BIN=codex
CODEX_EXEC_TIMEOUT_SEC=120

# Optional verified market-data adapter configuration.
MARKET_DATA_PROVIDER=
SEC_DATA_PROVIDER=
PORTFOLIO_PROVIDER=

# Toss Securities Open API (read-only adapters; do not commit values)
# --smoke-toss-accounts calls GET /api/v1/accounts and prints only accountSeq/accountType.
# Portfolio reads auto-discover a single accountSeq; set TOSS_ACCOUNT_SEQ only when
# multiple accounts are returned and you need to select one explicitly.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
TOSS_BASE_URL=https://openapi.tossinvest.com

# SEC/EDGAR public read-only access
SEC_USER_AGENT=

# Optional configured non-SEC evidence endpoint. The endpoint must return
# source_url, source_observed_at/published_at, and non-empty content/evidence.
RESEARCH_BASE_URL=
RESEARCH_PATH=/

# Optional projection-only Obsidian vault
OBSIDIAN_VAULT_ROOT=
