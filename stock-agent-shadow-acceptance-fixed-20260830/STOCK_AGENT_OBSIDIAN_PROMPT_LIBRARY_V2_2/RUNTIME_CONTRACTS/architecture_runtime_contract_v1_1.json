      "producer": "Python CapitalPrescreenGate",
      "produced_at_stage": "PRESCREEN"
    },
    "MarketExecutionGateReceipt": {
      "producer": "Python MarketExecutionGate",
      "produced_at_stage": "EXECUTION_RISK"
    }
  },
  "market_execution_gate_contract": {
    "passing_decisions": [
      "PASS",
      "PASS_WITH_CONSTRAINTS"
    ],
    "passing_requires_core_input_complete": true,
    "forbidden_passing_decision": "PASS_WITH_PARTIAL"
  },
  "add_lineage_receipts": {
    "PositionSnapshotReceiptV2": {
      "producer": "Python PortfolioRepository",
      "subject_must_match": "target_security_id"
    },
    "PriorAddTriggerReceiptV2": {
      "producer": "Python PlanRepository",
      "subject_must_match": "target_security_id",
      "trigger_must_match": "add_plan.trigger_id"
    },
    "FreshnessDeltaReceiptV2": {
      "producer": "Python FreshnessFence",
      "subject_must_match": "target_security_id",
      "delta_state": "STRENGTHENED"
    },
    "StrengtheningEvidenceReceiptV2": {
      "producer": "Python EvidenceRepository",
      "subject_must_match": "target_security_id"
    }
  },
  "semantic_invariants": {
    "StarterPlanV2": [
      "starter <= resulting post-add <= maximum position",
      "starter + planned add <= resulting post-add",
      "minimum_days <= maximum_days"
    ],
    "FailurePathV2": [
      "at least 3 distinct categories",
      "scenario+causal_path pairs are unique"
    ],
    "PortfolioComparisonResultV2": [
      "relative_rank unique",
      "asset_id+capital_path unique",
      "preferred row resolves exactly once",
      "capital_snapshot_id consistent"
    ],
    "ADD": [
      "all receipt subjects equal target_security_id",
      "trigger lineage matches",
      "AddPlan evidence is a non-empty subset of both strengthening receipts"
    ]
  },
  "holding_horizon_policy": {
    "owner": "Python RiskEngine / FinalAllocationGate",
    "default_rule_contract": "Investment Rules v2.0",
    "default_strategy_weeks": {
      "minimum": 1,
      "maximum": 8
    },
    "default_maximum_days": 56,
    "validation_rule": "starter_plan.maximum_holding_period.maximum_days <= active EffectiveRuleSet maximum_holding_days",
    "non_default_horizon_requires_active_rule_override": true
  },
