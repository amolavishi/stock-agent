{
  "contract_version": "1.1-prompt-integration-2.2",
  "architecture_reference": "STOCK_AGENT_ARCHITECTURE_V1.1",
  "architecture_sha256": "03a7863a49ebe53f7c58ee5d4e90fe1ac5cd4b55c84acb26dfeed84215005cd4",
  "rule_contract_version": "2.0",
  "library_version": "2.2.0",
  "stage_order": [
    "INPUT",
    "DISCOVERY",
    "PRESCREEN",
    "DEEP_RESEARCH",
    "FULL_SEC",
    "AUDIT",
    "EXECUTION_RISK",
    "FINAL_SYNTHESIS"
  ],
  "prompt_composer": {
    "algorithm": [
      "expand dependency graph",
      "dedupe by prompt_id",
      "deterministic topological order",
      "MIXIN first",
      "exactly one LEAF output owner",
      "canonical composition hash"
    ],
    "dedupe_key": "prompt_id",
    "output_owner_invariant": "exactly_one_leaf_output_schema",
    "composition_hash": "sha256(canonical ordered prompt_id + content_hash list)"
  },
  "schema_validation": {
    "draft": "2020-12",
    "registry": "SCHEMAS/output_schema_registry_v2_2.json",
    "flow": [
      "strict JSON extraction",
      "schema validation",
      "bounded repair",
      "reject"
    ]
  },
  "run_modes": {
    "HUNT_ONLY": {
      "terminal_projection": "QualifiedCandidatePool + DiscoveryDecision",
      "forbidden_dependencies": [
        "PortfolioSnapshot",
        "PositionSnapshot",
        "MarketExecutionGate",
        "RiskEngine",
        "FinalAllocation",
        "ExecutionAction",
        "ActionCard"
      ],
      "terminal_outcome_when_empty": "NO_QUALIFIED_CANDIDATE"
    },
    "HUNT_AND_EXECUTION_REVIEW": {
      "requires": [
        "fresh PortfolioSnapshot",
        "MarketExecutionGate receipt",
        "RiskAssessment"
      ],
      "allows": "non-authoritative ExecutionRecommendation"
    }
  },
  "gate_decisions": [
    "PASS",
    "PASS_WITH_PARTIAL",
    "PASS_WITH_CONSTRAINTS",
    "REJECT",
    "RETRY_WITH_NEW_EVIDENCE",
    "INSUFFICIENT_EVIDENCE",
    "SYSTEM_ERROR",
    "MANUAL_REVIEW_REQUIRED"
  ],
  "gate_decision_owner": "Python Domain Gate Engine",
  "capital_prescreen_receipts": {
    "llm_extraction": "capital_prescreen_extraction_receipt",
    "python_gate": "capital_prescreen_gate_receipt",
    "deep_research_required_gate_decisions": [
      "PASS",
      "PASS_WITH_CONSTRAINTS"
    ]
  },
  "typed_gate_receipts": {
    "MarketContextGateReceipt": {
      "producer": "Python MarketContextGate",
      "produced_at_stage": "DISCOVERY"
    },
    "SectorGateReceipt": {
      "producer": "Python SectorGate",
      "produced_at_stage": "DISCOVERY"
